// Starter schema. Replace with your real models.
// Run `pnpm --filter @__scope__/db migrate:dev --name <change-name>` after editing.
// The database connection URL lives in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
